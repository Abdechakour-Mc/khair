# Copy to .env only if you run outside Docker. docker-compose.yml already
# sets all of these for the containers.

DATABASE_URL=postgres://khair:khair@localhost:5433/khair
TEST_DATABASE_URL=postgres://khair:khair@localhost:5433/khair_test

# Guards the whole Admin view. Change it before the app is reachable.
ADMIN_PASSWORD=change-me

# Local phone numbers are read as belonging to this country. Khair identifies
# a Volunteer by phone number, so changing this later splits existing
# Volunteers in two.
DEFAULT_PHONE_COUNTRY=CA

# The mosque's own timezone. Decides which calendar day a Task is grouped
# under on the public list.
APP_TIMEZONE=America/Toronto

# Signups are deleted this many months after their Task's Deadline.
RETENTION_MONTHS=6

# --- Which mosque this deployment belongs to -------------------------
# One deployment serves one mosque. A second mosque means a second
# deployment with a different MOSQUE_NAME, not a tenant row in a table.
#
# Shown beside the wordmark on every public page and on the confirmation
# page, because a volunteer arriving from a QR code is being asked to type
# a phone number and "Khair" alone does not say whose form it is.
MOSQUE_NAME=Al-Madinah Center
# Optional. Left empty, the Arabic and French pages show MOSQUE_NAME.
MOSQUE_NAME_AR=
MOSQUE_NAME_FR=
# Optional path to a logo placed in public/, for example /mosque-logo.png.
# Never a URL on someone else's server. A flat raster is fine: the page
# gives it a light plate so it survives dark mode.
MOSQUE_LOGO=
